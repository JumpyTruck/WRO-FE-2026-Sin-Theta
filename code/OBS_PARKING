CAMERA_PIC_WIDTH = 640
CAMERA_PIC_HEIGHT = 360
PIC_WIDTH = 640
PIC_HEIGHT = 280

GRAY_THRESHOLD = 100  # same role as reference repo's THRESHOLD constant

# ---- lap-counting marker thresholds (masked-pixel count of the
# direction-relevant line within the track polygon) --------------------
# Two thresholds with a dead-band between them, instead of one shared
# value, so noise/occlusion flicker right around the boundary can't flip
# the entry/exit state back and forth and cause a double count:
#   - area must climb ABOVE the (higher) ENTER threshold to start a
#     crossing
#   - area must drop BELOW the (lower) EXIT threshold to end it
# Retune both against your actual track/lighting -- start by printing
# marker_area for a few laps and picking values that sit safely above
# the noise floor (exit) and safely above a true, fully-visible line
# (enter).
LINE_AREA_ENTER_THRESHOLD = 150
LINE_AREA_EXIT_THRESHOLD = 60

# =========================================================================
# LAB COLOR RANGES -- L: 0-255 (lightness), a: 0-255 (green<-128->red),
# b: 0-255 (blue<-128->yellow). Starting points only -- retune against
# your actual track/camera the same way the HSV ranges were tuned.
# =========================================================================
BLUE_LOWER = np.array([42, 128, 90])
BLUE_UPPER = np.array([140, 149, 127])

ORANGE_LOWER = np.array([65, 131, 136])
ORANGE_UPPER = np.array([255, 159, 255])

GREEN_LOWER = np.array([53, 91, 116])
GREEN_UPPER = np.array([154, 113, 187])

# red = high 'a' channel (no hue wraparound issue like HSV had, so
# just one range now instead of two)
RED_LOWER = np.array([24, 148, 142])
RED_UPPER = np.array([148, 182, 166])



MASK_CLEAN_KERNEL = np.ones((5, 5), np.uint8)


def calculate_color_mask(lab_img, color):
    """
    Plain function, no class -- returns a clean single-channel 0/255 mask.
    color is one of: "blue", "orange", "green", "red"
    """
    if color == "blue":
        mask = cv2.inRange(lab_img, BLUE_LOWER, BLUE_UPPER)
    elif color == "orange":
        mask = cv2.inRange(lab_img, ORANGE_LOWER, ORANGE_UPPER)
    elif color == "green":
        mask = cv2.inRange(lab_img, GREEN_LOWER, GREEN_UPPER)
    elif color == "red":
        mask = cv2.inRange(lab_img, RED_LOWER, RED_UPPER)
    else:
        mask = np.zeros(lab_img.shape[:2], dtype=np.uint8)

    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, MASK_CLEAN_KERNEL)
    mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, MASK_CLEAN_KERNEL)
    return mask



class Direction(Enum):
    LEFT = -1    # counterclockwise: robot follows the left wall, turns left at corners
    RIGHT = 1    # clockwise: robot follows the right wall, turns right at corners


def line_length(mask):
    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if not contours:
        return 0.0
    largest = max(contours, key=cv2.contourArea)
    (_, _), (rw, rh), _ = cv2.minAreaRect(largest)
    return max(rw, rh)


def detect_initial_direction(hsv_img, polygon_mask):
    blue_mask = calculate_color_mask(lab_img, "blue")
    orange_mask = calculate_color_mask(lab_img, "orange")
    blue_line = cv2.bitwise_and(blue_mask, blue_mask, mask=polygon_mask)
    orange_line = cv2.bitwise_and(orange_mask, orange_mask, mask=polygon_mask)
    blue_len = line_length(blue_line)
    orange_len = line_length(orange_line)
    print(f"[direction calibration] blue_len={blue_len:.1f}  orange_len={orange_len:.1f}")
    return Direction.LEFT if blue_len > orange_len else Direction.RIGHT


# =========================================================================
# EXIT-PARKING DIRECTION CALIBRATION
# =========================================================================
def detect_exit_parking_direction(polygon_image, display_frame):
    """
    One-shot direction calibration for exiting the parking spot: checks
    two fixed points against the floor (polygon) mask -- one near the
    LEFT edge of the frame, one near the RIGHT edge. Whichever side sees
    black (wall) tells us the robot should follow the OPPOSITE wall for
    the rest of the run:
        left point sees wall  -> Direction.RIGHT (follow the right wall)
        right point sees wall -> Direction.LEFT  (follow the left wall)

    Returns None if the reading is inconclusive (both points see wall,
    neither does, or the polygon isn't stable yet) so the caller can
    just keep calling this every frame until it gets a clean answer.
    """
    h, w = polygon_image.shape[:2]

    # (y, x) -- adjust these against your actual parking-exit framing
    left_point = (h - 50, 40)
    right_point = (h - 50, w - 40)

    ly, lx = left_point
    ry, rx = right_point

    left_wall = polygon_image[ly, lx] == 0
    right_wall = polygon_image[ry, rx] == 0

    # draw them so you can see what's being checked while tuning
    cv2.circle(display_frame, (lx, ly), 6, (255, 0, 255), -1)
    cv2.circle(display_frame, (rx, ry), 6, (255, 0, 255), -1)

    if left_wall and not right_wall:
        return Direction.RIGHT
    if right_wall and not left_wall:
        return Direction.LEFT
    return None


# =========================================================================
# EXIT-TURN MANEUVER (three-point turn out of the parking bay)
# =========================================================================
# Single point near the TOP of the frame -- i.e. far away, straight
# ahead -- used only during the "turning" phase below to detect the
# front wall closing in while the robot swings hard into its locked
# direction. (y, x) -- adjust against your actual parking-bay framing.
TOP_WALL_POINT = (15, PIC_WIDTH // 2)

# How long to hold the counter-steer and the reverse phases. Retune
# against your robot's actual turning radius/speed.
EXIT_COUNTER_TURN_DURATION = 1.0   # seconds
EXIT_BACKUP_DURATION = 1.0         # seconds


def check_top_wall(polygon_image, display_frame):
    """
    Checks the single TOP_WALL_POINT dot against the floor (polygon)
    mask. Returns True if it sees black (wall), meaning the front wall
    is now close enough, straight ahead, that the "turning" phase of the
    exit maneuver should stop and hand off to the counter-turn phase.
    """
    h, w = polygon_image.shape[:2]
    y, x = TOP_WALL_POINT
    in_bounds = 0 <= y < h and 0 <= x < w
    seen_wall = in_bounds and polygon_image[y, x] == 0
    if in_bounds:
        color = (0, 0, 255) if seen_wall else (0, 255, 255)
        cv2.circle(display_frame, (x, y), 6, color, -1)
    return seen_wall


# =========================================================================
# SERVO / STEERING CALIBRATION
# =========================================================================
default_servo = 90
max_turn_degree = 35
STEER_SIGN = -1
MIN_ANGLE = default_servo - max_turn_degree   # per this file's convention: MIN_ANGLE steers RIGHT
MAX_ANGLE = default_servo + max_turn_degree   # per this file's convention: MAX_ANGLE steers LEFT
MAX_ANGLE_STEP = 6   # max degrees the commanded angle may change per frame (slew limit) -- wall-follow only, see run()


def to_physical_angle(logical_angle):
    """
    Converts a "logical" servo angle (computed everywhere else in this
    file using the ORIGINAL convention: MIN_ANGLE steers right, MAX_ANGLE
    steers left) into the actual PWM angle the hardware needs, given the
    servo horn is now mounted upside down.

    This is the ONLY place the physical flip is applied. Every other
    function (wall_follow_angle, ObstacleTracker.obstacle_angle, the
    pillar-avoidance math, the slew-rate limiter in run()) keeps
    computing angles in the original coordinate system -- they don't
    need to know or care which way the servo is mounted.

    Mirroring around default_servo works cleanly because
    MIN_ANGLE = default_servo - max_turn_degree and
    MAX_ANGLE = default_servo + max_turn_degree, so this maps
    MIN_ANGLE <-> MAX_ANGLE exactly and default_servo -> default_servo.
    No extra clamping is needed since the mirrored value can never leave
    [MIN_ANGLE, MAX_ANGLE] if the input didn't.

    If the servo is ever remounted right-side up again, just set
    STEER_SIGN back to 1 and this correction switches off automatically.
    """
    if STEER_SIGN == -1:
        return int(round(2 * default_servo - logical_angle))
    return int(round(logical_angle))


# =========================================================================
# WALL-FOLLOW PD (ported from open challenge, rescaled)
# =========================================================================
TARGET_X = 0
TARGET_Y = 220

Kp_wall = 0.6
Kd_wall = 0.35
CORNER_THRESHOLD = PIC_HEIGHT // 2.5
prev_wall_error = 0.0


NBR_COLS = 10

def _find_black_from_bottom(img, col_range):
    h = img.shape[0]
    y_vals = []
    for x in col_range:
        found = 0  # nothing found -> treat as "far" (matches reference default)
        for y in reversed(range(h - 20)):
            if img[y, x] == 0:
                found = y
                break
        y_vals.append(found)
    return y_vals

def _find_black_sides(img, direction, row_range):
    w = img.shape[1]
    end_index = 0 if direction == Direction.LEFT else w - 1
    step = direction.value  # LEFT=-1, RIGHT=1 -- matches Direction enum already
    x_vals = []
    for y in row_range:
        found = end_index
        for x in range(w // 2, end_index, step):
            if img[y, x] == 0:
                found = x
                break
        x_vals.append(found)
    return x_vals

def wall_follow_angle(polygon_image, direction, display_frame, gain_scale=1.0):
    global prev_wall_error
    h, w = polygon_image.shape[:2]

    cols = range(0, NBR_COLS) if direction == Direction.LEFT else range(w - NBR_COLS, w)
    rows = range(h - 3 * NBR_COLS, h - 2 * NBR_COLS)

    y_vals = _find_black_from_bottom(polygon_image, cols)
    x_vals = _find_black_sides(polygon_image, direction, rows)

    avg_y = np.mean(y_vals)
    avg_x = np.mean(x_vals)
    if direction == Direction.RIGHT:
        avg_x = w - avg_x
    if avg_y >= h - 1:
        avg_y = h

    disp_x = int(avg_x) if direction == Direction.LEFT else int(w - avg_x)
    cv2.circle(display_frame, (disp_x, int(avg_y)), 8, (0, 0, 255), -1)
    cv2.circle(display_frame, (TARGET_X, TARGET_Y), 8, (0, 255, 0), -1)

    error_y = TARGET_Y - avg_y
    error_x = TARGET_X - avg_x
    error = error_y + error_x

    # ---- corner detection: same idea as the reference's p_compare/is_corner --
    # a big frame-to-frame jump in the combined error means the scan just
    # started hitting the corner/front wall instead of the side wall.
    derivative = error - prev_wall_error
    is_corner = derivative < -CORNER_THRESHOLD

    control = (Kp_wall * error) + (Kd_wall * derivative)
    prev_wall_error = error

    angle = default_servo + gain_scale * direction.value * control * -1
    angle = max(MIN_ANGLE, min(MAX_ANGLE, angle))
    return angle, is_corner


# =========================================================================
# POLYGON MASK -- IDENTICAL to the reference repo's
# ImageDrawingUtils.find_contour(img, white=1) + draw_polygon(binary, target)
# =========================================================================
def find_contour(img, white=0):
    contours, _ = cv2.findContours(img, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    if white == 1:
        target_pt = (PIC_WIDTH / 2, PIC_HEIGHT - 10)
        contours = [cnt for cnt in contours if cv2.pointPolygonTest(cnt, target_pt, False) >= 0]
    if not contours:
        return None, None
    biggest_contour = max(contours, key=cv2.contourArea)
    contours = [cnt for cnt in contours if not np.array_equal(cnt, biggest_contour)]
    if not contours:
        return biggest_contour, None
    second_biggest_contour = max(contours, key=cv2.contourArea)
    return biggest_contour, second_biggest_contour


def draw_polygon(binary_img, target_img):
    cnt, _ = find_contour(binary_img, 1)
    if cnt is None:
        return target_img, None
    epsilon = 0.001 * cv2.arcLength(cnt, True)
    polygon = cv2.approxPolyDP(cnt, epsilon, True)
    mask = np.zeros_like(binary_img)
    cv2.fillPoly(mask, [polygon], 255)
    result = cv2.bitwise_and(binary_img, mask)
    return result, polygon


