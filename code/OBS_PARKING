# =========================================================================
# ESP32 / MOTOR SERIAL
# =========================================================================
ser = serial.Serial('/dev/ttyUSB0', 115200, timeout=1)
time.sleep(2)

MOTOR_START_CMD = 888
MOTOR_STOP_CMD = 999
MOTOR_REVERSE_CMD = 777   # NOTE: confirm this matches whatever code the ESP32
                          # firmware actually expects for "drive backward" --
                          # 777 is a placeholder alongside 888/999.

LAPS_TARGET = 3
TOTAL_TURNS = LAPS_TARGET * 4   # 4 corners per lap

motor_command_queue = Queue()
servo_angle_queue = Queue()


def send_motor_start():
    ser.write(f"{MOTOR_START_CMD}\n".encode())
    print("[motor] START sent to ESP32")


def send_motor_stop():
    ser.write(f"{MOTOR_STOP_CMD}\n".encode())
    print("[motor] STOP sent to ESP32")


def send_motor_reverse():
    ser.write(f"{MOTOR_REVERSE_CMD}\n".encode())
    print("[motor] REVERSE sent to ESP32")


def send_angle(angle):
    ser.write(f"{angle}\n".encode())


def motor_drive():
    current_command = None
    while True:
        command = motor_command_queue.get()
        if command is None:
            break
        if command == current_command:
            continue
        if command == "drive":
            send_motor_start()
        elif command == "stop":
            send_motor_stop()
        elif command == "reverse":
            send_motor_reverse()
        current_command = command


def servo_move():
    while True:
        angle = servo_angle_queue.get()
        if angle is None:
            print("Servo disabled")
            break
        send_angle(angle)
        time.sleep(0.005)


