MIDDLE_X = PIC_WIDTH // 2
LEFT_OBSTACLE_X_THRESHOLD = 0
RIGHT_OBSTACLE_X_THRESHOLD = PIC_WIDTH - LEFT_OBSTACLE_X_THRESHOLD
OBJECT_LINE_ANGLE_THRESHOLD = 45
GREEN_OBSTACLE_KP = 1.35
RED_OBSTACLE_KP = 1.4

TOO_LOW_Y = PIC_HEIGHT - 45
TOO_CLOSE_Y = PIC_HEIGHT - 25

# Crash point marker color (BGR) -- blue, so it doesn't get lost against
# the green/red pillar drawing
CRASH_POINT_COLOR = (255, 0, 0)

# Minimum contour area for a red/green blob to be considered a pillar at
# all -- same role as the reference repo's `pillar_threshold`.
PILLAR_AREA_THRESHOLD = 250

# module-level, near TOO_LOW_Y / TOO_CLOSE_Y
PILLAR_COMMIT_DURATION = 0.025   # seconds to keep steering the last avoid
                                # angle after a pillar gets too close --
                                # tune this against your robot's speed:
                                # too short = still clips it, too long =
                                # misses/cuts off the next pillar

class ObstacleTracker:
    def __init__(self):
        self.old_angle = default_servo
        self.old_is_green = False
        self.crash_lock = None

    def check_inner_wall_crash(self, direction, polygon_image, display_frame, is_corner=False):
        """3 points near the side wall on the INSIDE of the turn (the
        side matching `direction`). Returns True if ANY of the 3 see
        black (wall), meaning the robot is riding too close to that
        wall.

        When is_corner is True (wall-follow just detected a sudden
        error spike), an extra pair of points further out/earlier in
        the turn is added, so a real corner trips this check a frame
        or two sooner than the base 3 points would alone.
        """
        if direction == Direction.RIGHT:
            detection_points = [
                (PIC_HEIGHT - 140, PIC_WIDTH - 195),
                (PIC_HEIGHT - 110, PIC_WIDTH - 170),
                (PIC_HEIGHT - 80, PIC_WIDTH - 145),
            ]
            corner_extra_points = [
                (PIC_HEIGHT - 110, PIC_WIDTH - 220),
                (PIC_HEIGHT - 95, PIC_WIDTH - 205),
            ]
        else:
            detection_points = [
                (PIC_HEIGHT - 140, 225),
                (PIC_HEIGHT - 110, 200),
                (PIC_HEIGHT - 80, 175),
            ]
            corner_extra_points = [
                (PIC_HEIGHT - 110, 250),
                (PIC_HEIGHT - 95, 235),
            ]

        if is_corner:
            detection_points = detection_points + corner_extra_points

        crashed = False
        for y, x in detection_points:
            in_bounds = 0 <= y < PIC_HEIGHT and 0 <= x < PIC_WIDTH
            point_crashed = in_bounds and polygon_image[y, x] == 0
            if point_crashed:
                crashed = True
            if in_bounds:
                color = (0, 255, 255) if is_corner else CRASH_POINT_COLOR
                cv2.circle(display_frame, (x, y), 5, color, -1)
        return crashed

    def check_outer_wall_crash(self, direction, polygon_image, display_frame, is_corner=False):
        """Single point straight ahead, plus an extra further-out point
        when is_corner is True, for the same early-trip reason as
        check_inner_wall_crash above."""
        if direction == Direction.RIGHT:
            detection_points = [(PIC_WIDTH - 370, PIC_HEIGHT - 155)]
            corner_extra_points = [(PIC_WIDTH - 380, PIC_HEIGHT - 185)]
        else:
            detection_points = [(PIC_WIDTH - 280, PIC_HEIGHT - 155)]
            corner_extra_points = [(PIC_WIDTH - 260, PIC_HEIGHT - 185)]

        if is_corner:
            detection_points = detection_points + corner_extra_points

        crashed = False
        for x, y in detection_points:
            in_bounds = 0 <= y < PIC_HEIGHT and 0 <= x < PIC_WIDTH
            point_crashed = in_bounds and polygon_image[y, x] == 0
            if point_crashed:
                crashed = True
            if in_bounds:
                color = (0, 255, 255) if is_corner else CRASH_POINT_COLOR
                cv2.circle(display_frame, (x, y), 5, color, -1)
        return crashed

    def find_closest_pillar(self, lab_img, polygon_mask, floor_binary, display_frame):
        """
        Ported from the reference repo's filter_pillars()/closest-distance
        loop in run(): scan the red and green masks, keep every contour
        above PILLAR_AREA_THRESHOLD, and track whichever one's center is
        closest (straight-line distance) to a fixed point directly in
        front of the robot (bottom-center of the frame).

        Unlike the reference repo this has NO ROI (it scans the whole
        polygon-masked frame, exactly like the rest of this file does for
        walls) and NO minimum-y gate -- there's no "too far away, ignore
        it" cutoff. Whatever red or green blob is nearest wins, full
        stop, every frame.
        """
        green_mask = calculate_color_mask(lab_img, "green")
        red_mask = calculate_color_mask(lab_img, "red")
        green_mask = cv2.bitwise_and(green_mask, green_mask, mask=polygon_mask)
        red_mask = cv2.bitwise_and(red_mask, red_mask, mask=polygon_mask)

        robot_point = (PIC_WIDTH // 2, PIC_HEIGHT)  # bottom-center of frame

        closest_distance = float("inf")
        closest = None  # (x_center, y_center, w, h, is_green)

        for mask, is_green in ((green_mask, True), (red_mask, False)):
            contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
            for cnt in contours:
                area = cv2.contourArea(cnt)
                if area <= PILLAR_AREA_THRESHOLD:
                    continue

                x, y, w, h = cv2.boundingRect(cnt)
                x_center = x + w // 2
                y_center = y + h // 2

                distance = math.dist((x_center, y_center), robot_point)
                if distance >= closest_distance:
                    continue

                closest_distance = distance
                closest = (x_center, y_center, w, h, is_green)

        if closest is None:
            return None

        x_center, y_center, w, h, is_green = closest

        top_left = (x_center - w // 2, y_center - h // 2)
        bottom_right = (x_center + w // 2, y_center + h // 2)
        cv2.rectangle(display_frame, top_left, bottom_right,
                       (0, 255, 0) if is_green else (0, 0, 255), 2)

        return x_center, y_center, is_green

    def obstacle_angle(self, direction, lab_img, polygon_mask, polygon_image, display_frame, is_corner=False):
        """
        Priority order:

          1. Crash avoidance -- checked and applied FIRST, every frame,
             and directly overrides steering (no passive "warning"
             state):
               - Outer dot sees black -> hard-steer INTO the turn
                 direction (left if going counterclockwise / direction
                 LEFT, right if going clockwise / direction RIGHT) until
                 the outer dot clears.
               - Any of the 3 inner dots sees black -> hard-steer AWAY
                 from that inner wall (right if counterclockwise, left
                 if clockwise) until all 3 inner dots clear.
               - Outer takes priority if both trip in the same frame,
                 since it's the more urgent straight-ahead collision.
               - Once a lock engages it stays locked (ignoring the other
                 check) until its own trigger clears, so recovery isn't
                 cut short mid-turn.
          2. Otherwise: normal pillar detection/avoidance.
        """
        inner_crash = self.check_inner_wall_crash(direction, polygon_image, display_frame, is_corner)
        outer_crash = self.check_outer_wall_crash(direction, polygon_image, display_frame, is_corner)

        turn_into_corner = (MAX_ANGLE-3) if direction == Direction.LEFT else (MIN_ANGLE+3)
        turn_away_from_wall = (MIN_ANGLE+3) if direction == Direction.LEFT else (MAX_ANGLE-3)

        # crash avoidance always wins outright, and cancels any pillar commit
        if self.crash_lock == "outer":
            if outer_crash:
                return turn_into_corner
            self.crash_lock = None
        elif self.crash_lock == "inner":
            if inner_crash:
                return turn_away_from_wall
            self.crash_lock = None

        if outer_crash:
            self.crash_lock = "outer"
            return turn_into_corner
        if inner_crash:
            self.crash_lock = "inner"
            return turn_away_from_wall

        # ---- pillar commit: once a pillar got too close, hold the last
        # avoid angle for a fixed duration instead of handing control
        # back to wall-follow the instant detection drops out. We also
        # skip find_closest_pillar entirely while committed, so the
        # robot can't re-latch onto the tail of the pillar it's passing
        # -- it just drives the commit angle blind until it's clear,
        # then goes looking for the next block.

        #if time.time() < self.commit_until:
         #   return self.old_angle

        found = self.find_closest_pillar(lab_img, polygon_mask, polygon_image, display_frame)
        if found is None:
            return None
        x_center, y_center, is_green = found

        if y_center > TOO_LOW_Y:
            if y_center > TOO_CLOSE_Y:
                # right on top of it -- stop tracking, commit to the pass
                #self.commit_until = time.time() + PILLAR_COMMIT_DURATION
                #return self.old_angle
                return None
            return self.old_angle

        if is_green:
            cv2.line(display_frame, (x_center, y_center), (RIGHT_OBSTACLE_X_THRESHOLD, PIC_HEIGHT), (0, 255, 0), 2)
            rad_angle = np.arctan2(y_center - PIC_HEIGHT, x_center - RIGHT_OBSTACLE_X_THRESHOLD)
        else:
            cv2.line(display_frame, (x_center, y_center), (LEFT_OBSTACLE_X_THRESHOLD, PIC_HEIGHT), (0, 0, 255), 2)
            rad_angle = np.arctan2(y_center - PIC_HEIGHT, x_center - LEFT_OBSTACLE_X_THRESHOLD)

        object_angle_deg = 90 + np.degrees(rad_angle)

        if is_green:
            servo_angle = default_servo - ((object_angle_deg + OBJECT_LINE_ANGLE_THRESHOLD) * GREEN_OBSTACLE_KP)
        else:
            servo_angle = default_servo - ((object_angle_deg - OBJECT_LINE_ANGLE_THRESHOLD) * RED_OBSTACLE_KP)

        servo_angle = max(MIN_ANGLE, min(MAX_ANGLE, servo_angle))
        self.old_angle = servo_angle
        self.old_is_green = is_green
        return servo_angle


# =========================================================================
# CORNER / TURN (LAP-COUNTING) STATE MACHINE
# =========================================================================
# Debounce constants for the marker-crossing detector in run(). A
# crossing only STARTS once the direction-relevant line has been seen
# above LINE_AREA_ENTER_THRESHOLD for ENTRY_CONFIRM_FRAMES straight
# frames (filters single-frame noise), and only COUNTS/resets once the
# line has dropped below the lower LINE_AREA_EXIT_THRESHOLD for
# EXIT_CONFIRM_FRAMES straight frames AND at least TURN_MIN_DURATION has
# passed since it was first seen.
#
# TURN_MIN_DURATION and TURN_COOLDOWN are deliberately set close to (or
# a bit above) how long a real corner takes your robot to drive through
# at speed -- this, combined with the enter/exit dead-band above, is
# what stops a single physical corner from being counted twice (a brief
# mid-corner dip in the marker mask can no longer both (a) cross the
# lower exit threshold long enough to "finish" the quarter AND (b) still
# leave enough real corner left over for the marker to climb back over
# the higher enter threshold and register as a second, new quarter).
# TURN_MAX_DURATION is a hard safety valve so a stuck detection can't
# wedge the whole counter forever. RETUNE TURN_MIN_DURATION/
# TURN_COOLDOWN against your actual corner-traversal time -- if you're
# still seeing double (or missed) counts, watch the printed marker_area
# / [lap] log while driving one lap manually and adjust these numbers
# and/or the two area thresholds above.
ENTRY_CONFIRM_FRAMES = 3
EXIT_CONFIRM_FRAMES = 6
TURN_MIN_DURATION = 1.0
TURN_MAX_DURATION = 4.0
TURN_COOLDOWN = 2.0


def crop_image(img, x_start, x_end, y_start, y_end):
    return img[y_start:y_end, x_start:x_end]


def main():
    t1 = threading.Thread(target=motor_drive, name='motor')
    t2 = threading.Thread(target=servo_move, name='servo')
    t1.start()
    t2.start()
    run()
    t1.join()
    t2.join()


def run():
    picam2 = Picamera2()
    sensor_mode = picam2.sensor_modes[1]
    sensor_width, sensor_height = sensor_mode["size"]
    config = picam2.create_video_configuration(
        raw={"size": (sensor_width, sensor_height)},
        main={"format": "RGB888", "size": (CAMERA_PIC_WIDTH, CAMERA_PIC_HEIGHT)},
        controls={"FrameRate": 30}
    )
    picam2.configure(config)
    picam2.start()
    for _ in range(10):
        picam2.capture_array()

    # Direction is no longer hardcoded -- it's determined once by the
    # exit-parking calibration below, then locked for the rest of the run.
    direction = None
    direction_locked = False
    motor_started = False

    # Three-point exit-turn maneuver, runs once right after direction is
    # locked and before the main wall-follow loop takes over. See the
    # docstring section "Exit-turn maneuver" and check_top_wall() above.
    exit_maneuver_state = "turning"   # "turning" -> "counter_turn" -> "backing_up" -> "done"
    exit_phase_deadline = 0.0         # time.time() deadline for the timed phases

    tracker = ObstacleTracker()

    turn_state = "idle"
    turn_counter = 0
    confirm_count = 0
    exit_confirm_count = 0
    turn_start_time = 0.0
    turn_cooldown_until = 0.0

    prevang = None
    servo_angle_queue.put(to_physical_angle(default_servo))

    while True:
        raw_frame = picam2.capture_array()
        frame = crop_image(raw_frame, 0, CAMERA_PIC_WIDTH, CAMERA_PIC_HEIGHT - PIC_HEIGHT, CAMERA_PIC_HEIGHT)

        lab = cv2.cvtColor(frame, cv2.COLOR_BGR2LAB)

        blue_mask = calculate_color_mask(lab, "blue")
        orange_mask = calculate_color_mask(lab, "orange")
        green_mask = calculate_color_mask(lab, "green")
        red_mask = calculate_color_mask(lab, "red")

        colormask_image = frame.copy()
        non_wall_mask = cv2.bitwise_or(cv2.bitwise_or(blue_mask, orange_mask),
                                       cv2.bitwise_or(green_mask, red_mask))
        colormask_image[non_wall_mask > 0] = (255, 255, 255)

        grayscale_image = cv2.cvtColor(colormask_image, cv2.COLOR_BGR2GRAY)
        blurred_image = cv2.bilateralFilter(grayscale_image, 9, 75, 75)
        _, binary_image = cv2.threshold(blurred_image, GRAY_THRESHOLD, 255, cv2.THRESH_BINARY)
        clean_image = cv2.morphologyEx(binary_image, cv2.MORPH_CLOSE, np.ones((5, 5), np.uint8))

        polygon_image, polygon_points = draw_polygon(clean_image, clean_image)
        polygon_mask = np.zeros_like(clean_image)
        if polygon_points is not None:
            cv2.fillPoly(polygon_mask, [polygon_points], 255)
            cv2.polylines(frame, [polygon_points], True, (0, 0, 255), 2, lineType=cv2.LINE_AA)

        if not motor_started:
            motor_command_queue.put("drive")
            motor_started = True
            continue

        # ---- EXIT-PARKING DIRECTION CALIBRATION -----------------------
        # Runs once, before anything else (lap counting, wall-follow,
        # obstacle avoidance). Drives straight while checking two fixed
        # points near the left/right edges of the floor mask. Whichever
        # side sees the wall locks in the OPPOSITE direction for the
        # rest of the run, prints it once, and this block never runs
        # again -- everything below proceeds exactly as it did before,
        # just using the now-locked `direction`.
        if not direction_locked:
            detected = detect_exit_parking_direction(polygon_image, frame)
            if detected is not None:
                direction = detected
                direction_locked = True
                print(f"[exit-parking] direction locked: {direction.name}")
            else:
                servo_angle_queue.put(to_physical_angle(default_servo))
                cv2.imshow("frame", frame)
                cv2.imshow("polygon mask", polygon_mask)
                key = cv2.waitKey(1) & 0xFF
                if key == ord('q'):
                    motor_command_queue.put("stop")
                    servo_angle_queue.put(None)
                    break
                continue

        # ---- EXIT-TURN MANEUVER (three-point turn) --------------------
        # Runs once, right after direction locks and before the main
        # lap-counting/wall-follow/obstacle loop below ever executes.
        # All logical angles here still use the ORIGINAL (pre-servo-flip)
        # convention -- to_physical_angle() handles the mirroring at the
        # very end, same as everywhere else in this file.
        if exit_maneuver_state != "done":
            hard_into_direction = MAX_ANGLE if direction == Direction.LEFT else MIN_ANGLE
            hard_away_from_direction = MIN_ANGLE if direction == Direction.LEFT else MAX_ANGLE

            if exit_maneuver_state == "turning":
                # Steer hard into the locked direction and drive forward,
                # watching the top-of-frame dot for the front wall closing in.
                motor_command_queue.put("drive")
                servo_angle_queue.put(to_physical_angle(hard_into_direction))
                if check_top_wall(polygon_image, frame):
                    print("[exit-maneuver] front wall detected -> counter-turn")
                    exit_maneuver_state = "counter_turn"
                    exit_phase_deadline = time.time() + EXIT_COUNTER_TURN_DURATION

            elif exit_maneuver_state == "counter_turn":
                # Steer hard the OTHER way for a fixed duration, still
                # driving forward, to swing the back end around.
                motor_command_queue.put("drive")
                servo_angle_queue.put(to_physical_angle(hard_away_from_direction))
                if time.time() >= exit_phase_deadline:
                    print("[exit-maneuver] counter-turn done -> backing up")
                    exit_maneuver_state = "backing_up"
                    exit_phase_deadline = time.time() + EXIT_BACKUP_DURATION

            elif exit_maneuver_state == "backing_up":
                # Wheels straight, reverse the motor for a fixed duration.
                motor_command_queue.put("reverse")
                servo_angle_queue.put(to_physical_angle(default_servo))
                if time.time() >= exit_phase_deadline:
                    print("[exit-maneuver] backup done -> main loop taking over")
                    exit_maneuver_state = "done"
                    motor_command_queue.put("drive")

            cv2.imshow("frame", frame)
            cv2.imshow("polygon mask", polygon_mask)
            key = cv2.waitKey(1) & 0xFF
            if key == ord('q'):
                motor_command_queue.put("stop")
                servo_angle_queue.put(None)
                break
            continue

        # ---- lap-counting marker: LEFT direction only ever watches the
        # BLUE line, RIGHT direction only ever watches the ORANGE line --
        # the other color is ignored entirely for counting purposes, so
        # a stray glimpse of it can never add a false quarter. The mask
        # is ANDed against the current track polygon (not a fixed ROI
        # box) so color detected outside the drivable area is ignored
        # too. Hysteresis (separate enter/exit thresholds) + longer
        # min-duration/cooldown -- see the comment on the constants
        # above -- is what prevents a single physical corner from being
        # counted twice. This block is purely a counter -- it never
        # touches steering.
        now = time.time()
        marker_mask = blue_mask if direction == Direction.LEFT else orange_mask
        marker_mask = cv2.bitwise_and(marker_mask, marker_mask, mask=polygon_mask)
        marker_area = cv2.countNonZero(marker_mask)

        if turn_state == "idle":
            if now >= turn_cooldown_until:
                confirm_count = confirm_count + 1 if marker_area > LINE_AREA_ENTER_THRESHOLD else 0
                if confirm_count >= ENTRY_CONFIRM_FRAMES:
                    turn_state = "turning"
                    turn_start_time = now
                    exit_confirm_count = 0
                    confirm_count = 0
        else:
            turn_elapsed = now - turn_start_time
            exit_confirm_count = exit_confirm_count + 1 if marker_area < LINE_AREA_EXIT_THRESHOLD else 0
            should_exit = (turn_elapsed >= TURN_MIN_DURATION and exit_confirm_count >= EXIT_CONFIRM_FRAMES) \
                or (turn_elapsed >= TURN_MAX_DURATION)
            if should_exit:
                turn_counter += 1
                print(f"[lap] quarter {turn_counter}/{TOTAL_TURNS} complete "
                      f"({turn_counter // 4} lap(s) + {turn_counter % 4} quarter(s))")
                turn_state = "idle"
                turn_cooldown_until = now + TURN_COOLDOWN
                confirm_count = 0
                exit_confirm_count = 0

        # ---- crash-avoidance / pillar-avoidance angle (may override
        # wall-follow entirely) ----

        wall_angle, wall_is_corner = wall_follow_angle(polygon_image, direction, frame)

        # Straight two-way choice: crash/pillar override wins if present,
        # otherwise wall-follow drives. wall_is_corner (from wall-follow's
        # own PD-error spike detector) is passed in so the crash-avoidance
        # dots can add their extra, further-out points and trip a frame
        # or two sooner during a real corner.
        obstacle_angle = tracker.obstacle_angle(direction, lab, polygon_mask, polygon_image, frame, wall_is_corner)

        final_angle = obstacle_angle if obstacle_angle is not None else wall_angle

        target_angle = max(MIN_ANGLE, min(MAX_ANGLE, final_angle))

        # ---- slew-rate limit: WALL-FOLLOW ONLY. Crash avoidance and
        # pillar avoidance must react the instant the angle is computed --
        # slew-limiting those made the robot lag behind its own
        # calculated angle. Only plain wall-follow gets eased, to take
        # the edge off minor point-to-point wobble.
        #
        # NOTE: this all still operates in the ORIGINAL (logical) angle
        # convention -- prevang, target_angle, delta, MIN_ANGLE/MAX_ANGLE
        # clamping are untouched by the servo flip. Only the final value
        # handed to the hardware queue below gets mirrored.
        #if obstacle_angle is not None or prevang is None:
         #   angle = round(target_angle)
        #else:
        #    delta = max(-MAX_ANGLE_STEP, min(MAX_ANGLE_STEP, target_angle - prevang))
         #   angle = round(prevang + delta)
        #angle = max(MIN_ANGLE, min(MAX_ANGLE, angle))
        angle = round(target_angle)
        angle = max(MIN_ANGLE, min(MAX_ANGLE, angle))

        if prevang is None or prevang != angle:
            servo_angle_queue.put(to_physical_angle(angle))
            prevang = angle

        cv2.imshow("frame", frame)
        cv2.imshow("polygon mask", polygon_mask)

        key = cv2.waitKey(1) & 0xFF
        if key == ord('q'):
            motor_command_queue.put("stop")
            servo_angle_queue.put(None)
            break

        if turn_counter >= TOTAL_TURNS:
            print(f"Completed {TOTAL_TURNS} quarters ({LAPS_TARGET} laps), stopping.")
            motor_command_queue.put("stop")
            servo_angle_queue.put(None)
            break

    picam2.stop()
    cv2.destroyAllWindows()
    ser.close()


if __name__ == "__main__":
    main()
